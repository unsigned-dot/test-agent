# Copier ce fichier en .env puis adapter. Le fichier .env n'est jamais versionné.

# --- Tor : proxy SOCKS (trafic applicatif) -------------------------------
# Doit rester en local (127.0.0.1 / ::1 / localhost) : le client refuse le reste.
TOR_SOCKS_HOST=127.0.0.1
TOR_SOCKS_PORT=9050

# --- Tor : ControlPort (NEWNYM) ------------------------------------------
TOR_CONTROL_HOST=127.0.0.1
TOR_CONTROL_PORT=9051
# Laisser vide pour l'authentification par cookie (recommandé).
# À renseigner uniquement si torrc utilise HashedControlPassword.
TOR_CONTROL_PASSWORD=

# --- Requêtes --------------------------------------------------------------
# Délai de lecture (s). CONNECT_TIMEOUT vaut REQUEST_TIMEOUT s'il est vide.
REQUEST_TIMEOUT=15
CONNECT_TIMEOUT=
# Nombre de nouvelles tentatives après le premier essai (0 à 10).
MAX_RETRIES=3

# --- NEWNYM ------------------------------------------------------------------
# Attente après un NEWNYM accepté (s).
TOR_NEWNYM_WAIT=10
# Intervalle minimal entre deux NEWNYM (Tor limite à ~1 toutes les 10 s).
TOR_NEWNYM_MIN_INTERVAL=10
# Délai max pour que Tor annonce un circuit établi (s).
TOR_READY_TIMEOUT=30

# --- Backoff -----------------------------------------------------------------
BACKOFF_BASE=1
BACKOFF_MAX=30
# Retry-After au-delà duquel on abandonne au lieu d'attendre (s).
RETRY_AFTER_MAX=120
# Changer de circuit sur erreur 5xx (désactivé : un 5xx vient en général du serveur).
ROTATE_ON_5XX=false
# Rejouer POST/PATCH même si la requête a pu atteindre le serveur (risque de doublon).
RETRY_NON_IDEMPOTENT=false

# --- Services de vérification ------------------------------------------------
# Doit renvoyer du JSON {"IsTor": true|false, ...} (format check.torproject.org).
TOR_CHECK_URL=https://check.torproject.org/api/ip
# Service renvoyant l'IP (JSON avec IP/ip/origin/query, ou texte brut).
IP_CHECK_URL=https://check.torproject.org/api/ip

# --- Divers ------------------------------------------------------------------
# Liste blanche optionnelle d'hôtes (séparés par des virgules ; sous-domaines inclus).
ALLOWED_HOSTS=
USER_AGENT=
LOG_LEVEL=INFO
